{
  "name": "elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ELEMENTS \u2014 a landscape puzzle-platformer foundation for iOS and web.",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "audit:assets": "node scripts/audit-assets.js",
    "test:illustrated:browser": "node scripts/illustrated-campaign-smoke.js",
    "test:illustrated:editor": "node scripts/illustrated-campaign-editor-smoke.js",
    "test:illustrated:negative": "node scripts/earth-puzzle-negative-smoke.js",
    "audit:illustrated": "node scripts/integrate-illustrated-assets.js --check"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
